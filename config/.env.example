# Application
APP_ENV=development
APP_NAME=nwis-api
DEBUG=true

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nwis
DATABASE_POOL_SIZE=10

# Object Storage (MinIO / S3)
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=nwis-documents
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin

# Broker / Queue
BROKER_URL=redis://localhost:6379/0

# OCR
OCR_TEXT_LAYER_THRESHOLD_CHARS=100
OCR_PAGE_CONFIDENCE_FLOOR=0.5
OCR_HEADER_REPEAT_THRESHOLD=0.6

# Correlation & Risk
CORRELATION_DEPTH_BAND_M=100.0
CORRELATION_DEFAULT_RADIUS_KM=5.0
RISK_THRESHOLD_MEDIUM=2
RISK_THRESHOLD_HIGH=3

# Alerts
ALERT_ESCALATION_TIMEOUT_SEC=1800

# eRTMAC
ERTMAC_STALENESS_THRESHOLD_SEC=60
ERTMAC_ADAPTER_MODE=simulator

# Auth & Security
OIDC_ISSUER_URL=http://localhost:8080/realms/nwis
OIDC_AUDIENCE=nwis-api
JWT_SECRET_KEY=dev-insecure-secret-key-change-in-production
SECRETS_BACKEND=env
